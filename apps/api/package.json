{
  "name": "@webs/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@webs/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.11",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.12",
    "node-html-parser": "^9.0.4",
    "postgres": "^3.4.9",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
