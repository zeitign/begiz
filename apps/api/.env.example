# Copia este archivo como .env y rellénalo.

# Supabase → Project Settings → Database → Connection string → "Session pooler"
# (la conexión directa es solo IPv6 en el plan gratuito).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://<ref>.supabase.co

# Solo si tu proyecto usa aún las claves JWT antiguas (HS256). Los proyectos nuevos no lo necesitan.
# SUPABASE_JWT_SECRET=

# --- Imágenes ---
# En local se guardan en disco (apps/api/.data/uploads) y las sirve la propia API.
STORAGE_DRIVER=local
FILES_PUBLIC_URL=/files

# En producción, Cloudflare R2:
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=webs-archive
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# FILES_PUBLIC_URL=https://<dominio-público-del-bucket>

# Solo en producción: origen del front (varios separados por comas).
# CORS_ORIGIN=https://webs-archive.pages.dev
