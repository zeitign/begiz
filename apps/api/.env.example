# Copy this file as .env and fill it in.

# Supabase → Project Settings → Database → Connection string → "Session pooler"
# (the direct connection is IPv6-only on the free plan).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://<ref>.supabase.co

# Only if your project still uses the legacy JWT keys (HS256). New projects do not need it.
# SUPABASE_JWT_SECRET=

# --- Images ---
# Locally they are stored on disk (apps/api/.data/uploads) and served by the API itself.
STORAGE_DRIVER=local
FILES_PUBLIC_URL=/files

# In production, Cloudflare R2:
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=webs-archive
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# FILES_PUBLIC_URL=https://<bucket-public-domain>

# Production only: front origin (several separated by commas).
# CORS_ORIGIN=https://webs-archive.pages.dev
