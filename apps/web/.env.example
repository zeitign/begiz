# Copia este archivo como .env y rellénalo.
# Supabase → Project Settings → API

VITE_SUPABASE_URL=https://<ref>.supabase.co
# "Publishable key" (sb_publishable_…) o, en proyectos antiguos, la "anon key". Es pública: puede ir en el front.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Solo en producción, si la API está en otro dominio. En local se usa el proxy de Vite.
# VITE_API_URL=https://api.ejemplo.com
