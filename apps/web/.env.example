# Copy this file as .env and fill it in.
# Supabase → Project Settings → API

VITE_SUPABASE_URL=https://<ref>.supabase.co
# "Publishable key" (sb_publishable_…) or, in older projects, the "anon key". It is public: safe in the front.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Production only, when the API lives on another domain. Locally the Vite proxy is used.
# VITE_API_URL=https://api.example.com
